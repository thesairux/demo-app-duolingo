      "tipoNodo": "leccion",
      "guia": [
        {
          "titulo": "Partes iguales",
          "texto": "Una fracción indica partes iguales de un entero. Si cortas una pizza en 4 partes iguales y comes 1, comiste 1/4 (un cuarto).",
          "ejemplo": "🍕 Una pizza en 4 trozos iguales: cada trozo es 1/4.",
          "fuentes": [
            {
              "archivo": "Bases Curriculares Matemática 4° básico (Mineduc)",
              "seccion": "OA 8",
              "fueraDelMaterial": false
            }
          ],
          "revisar": false
        },
        {
          "titulo": "Arriba y abajo",
          "texto": "El número de abajo es el denominador: en cuántas partes iguales se dividió el entero. El de arriba es el numerador: cuántas partes tomas.",
          "ejemplo": "3/5: tomas 3 de 5 partes iguales.",
          "fuentes": [
            {
              "archivo": "Bases Curriculares Matemática 4° básico (Mineduc)",
              "seccion": "OA 8",
              "fueraDelMaterial": false
            }
          ],
          "revisar": false
        },
        {
          "titulo": "Cómo se leen",
          "texto": "1/2 es un medio, 1/3 un tercio, 1/4 un cuarto y 1/5 un quinto. Desde el 11 se dice «avos»: 1/12 es un doceavo.",
          "ejemplo": "2/3 se lee «dos tercios».",
          "fuentes": [
            {
              "archivo": "Bases Curriculares Matemática 4° básico (Mineduc)",
              "seccion": "OA 8",
